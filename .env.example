# Môi trường ứng dụng: development | test | production
APP_ENV=development
APP_URL=http://localhost:3001
TZ=Asia/Ho_Chi_Minh

# Kết nối PostgreSQL
# - Production / Docker: postgres://tnth_work:CHANGE_ME@127.0.0.1:5432/tnth_work?sslmode=disable
# - Local development không cài Docker/Postgres: pglite://./.data/pglite (BỊ CHẶN ở production)
DATABASE_URL=pglite://./.data/pglite
DB_POOL_MAX=5

# Tích hợp xác thực cổng thông tin thanhnientruonghoc.io.vn
# - development/test: mock (BỊ CHẶN ở production)
# - production: sso | bridge
PORTAL_AUTH_MODE=mock
PORTAL_BASE_URL=https://thanhnientruonghoc.io.vn
PORTAL_CLIENT_ID=tnth-work-local
PORTAL_CLIENT_SECRET=replace-in-production
PORTAL_ALLOWED_REDIRECT_URI=http://localhost:3001/auth/callback
PORTAL_TIMEOUT_MS=5000

# Phiên đăng nhập (mặc định 7 ngày = 604800 giây)
SESSION_TTL_SECONDS=604800
IDENTITY_RECHECK_SECONDS=300

# Lưu trữ tệp nội bộ (ngoài thư mục public/)
UPLOAD_DIR=./uploads
MAX_AVATAR_BYTES=5242880
MAX_UPLOAD_BYTES=52428800
MAX_SUBMISSION_BYTES=104857600
MAX_SUBMISSION_FILES=20
STORAGE_QUOTA_BYTES=5368709120

# Cho phép bootstrap HEAD một lần (đặt false ngay sau khi chạy xong ở production)
ALLOW_HEAD_BOOTSTRAP=false
